class Rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def area(self):
        return self.width * self.height

    def perimeter(self):
        return 2 * (self.width + self.height)

rectangles = [
    Rectangle(4, 5),
    Rectangle(6, 3),
    Rectangle(8, 4),
    Rectangle(5, 5)
]

for i in range(4):
    print("Rectangle", i + 1)